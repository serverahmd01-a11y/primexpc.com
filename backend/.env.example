# ================= ENVIRONMENT VARIABLES =================
# Copy this file to .env and fill in real values.
# On Hostinger: set these in hPanel -> Web App -> Environment Variables.

# development | production
NODE_ENV=production

# Server port (Hostinger sets this automatically, keep 3000)
PORT=3000

# MongoDB connection string
# Local:  mongodb://localhost:27017/primexpc
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/primexpc
DB_URL=mongodb://localhost:27017/primexpc

# Strong random secret (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# Public site URL (used for CORS + sitemap + links)
CLIENT_URL=https://primexpc.com

# Persistent uploads folder (images/videos)
# Local default: ./uploads (leave empty)
# Hostinger: absolute path OUTSIDE hbuilds, e.g.
#   /home/u12345678/domains/primexpc.com/uploads
UPLOADS_DIR=

# Razorpay (optional - also configurable from admin panel)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: first signup becomes admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
